# Copy this file to .env and fill in the key. Never commit .env.
# Create a key at https://console.x.ai/

XAI_API_KEY=

# Optional. Current flagship as of the models page:
# https://docs.x.ai/developers/models
XAI_MODEL=grok-4.7

# Optional. OpenAI-compatible base URL. A US-only endpoint also exists;
# see https://docs.x.ai/developers/grok-4-7
XAI_BASE_URL=https://api.x.ai/v1

# Optional. grok-4.7 is a reasoning model, so a call can sit for a while
# before the first token of the answer. Value is milliseconds.
XAI_TIMEOUT_MS=120000

# Optional. One step is one model call.
AGENT_MAX_STEPS=8

# Optional. One JSONL file per run is written here.
AGENT_TRACE_DIR=traces

# Optional. The scratchpad tool can only read and write inside this directory.
AGENT_SCRATCH_DIR=scratch
